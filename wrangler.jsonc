{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glassbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },

  // Static chat UI. The Worker runs first for /api/*; everything else is served
  // straight from the asset store without invoking the Worker at all.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /mcp is listed explicitly: without it the asset store would answer the MCP endpoint with a
    // 404 and the Worker would never run.
    "run_worker_first": ["/api/*", "/mcp"]
  },

  // Bundles the committed evaluation set as text so the MCP `list_eval_cases` tool reads the
  // same file the harness measures against, rather than a copy that can drift from it.
  "rules": [
    { "type": "Text", "globs": ["**/*.jsonl"], "fallthrough": true }
  ],

  "ai": { "binding": "AI" },

  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "glassbox-corpus" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glassbox-evals",
      "database_id": "7becd827-6579-4eb9-bcda-a541c1155485"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "CHAT_AGENT", "class_name": "ChatAgent" }]
  },

  // SQLite-backed is the only Durable Object storage class available on the
  // Workers Free plan, and is what this design uses regardless.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }
  ]
}
