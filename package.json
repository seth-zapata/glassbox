{
  "name": "glassbox",
  "version": "1.0.0",
  "description": "A glass-box RAG agent on Cloudflare Workers — it refuses to guess, and shows the evidence either way.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "login": "wrangler login --browser false",
    "login:device": "wrangler login --device",
    "whoami": "wrangler whoami",
    "transcript": "node --experimental-strip-types scripts/export-transcript.ts",
    "transcript:check": "node --experimental-strip-types scripts/check-transcript-leaks.ts",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "transcript:check:ci": "node --experimental-strip-types scripts/check-transcript-leaks.ts --credentials-only",
    "corpus:fetch": "node --experimental-strip-types scripts/fetch-corpus.ts",
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "deploy": "wrangler deploy",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "corpus:check": "node --experimental-strip-types scripts/check-corpus.ts"
  },
  "author": "Seth Zapata",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
  "private": true,
  "type": "module"
}
