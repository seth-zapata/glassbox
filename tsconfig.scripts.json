{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2023"]
  },
  // Scripts and tests import Worker modules, so the generated Workers runtime types are needed
  // here too — otherwise `Ai` and `VectorizeIndex` are unresolved in anything under test.
  "include": ["scripts/**/*.ts", "test/**/*.ts", "src/**/*.ts", "worker-configuration.d.ts"]
}
